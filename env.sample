# Language

LANGUAGE_DEFAULT="en"

 

# Mixcloud

MIXCLOUD_NAME="THF Radio"

MIXCLOUD_API="https://api.mixcloud.com/thfradio/cloudcasts/"

NEXT_PUBLIC_MIXCLOUD_API="https://api.mixcloud.com/thfradio/cloudcasts/"

 

# Radio

# Live streams are fixed in src/app/_lib/liveChannels.ts (no env needed):
# THF1 https://stream.thfradio.space/live.mp3
# THF2 https://stream.thfradio.space/live2.mp3

# Channel 1 timetable from thfradio.space; Teamup ICS is the fallback
# (API error / no key / empty). CALENDAR_1_SOURCE="teamup" forces the ICS feed.
CALENDAR_1_URL="https://www.thfradio.space/api/public/timetable/1"
# Empty = use CALENDAR_2_KEY
CALENDAR_1_KEY=""
#CALENDAR_1_SOURCE="teamup"

CALENDAR_2_URL="https://www.thfradio.space/api/public/timetable/2"
CALENDAR_2_KEY="your-api-key"
# Channel 1 timetable from thfradio.space (key must allow channel 1;
# one key for channels 1+2 can go in both). Without it: Teamup ICS feed.
CALENDAR_1_URL="https://www.thfradio.space/api/public/timetable/1"
CALENDAR_1_KEY="your-api-key"
# CALENDAR_1_SOURCE=teamup   forces the Teamup feed

# Shows from thfradio.space (see INTRANET_SHOWS.md)
# "intranet" = read show info from thfradio.space, old backend only as fallback.
SHOWS_SOURCE="backend"
INTRANET_API_URL="https://www.thfradio.space"
# Timetable API key from thfradio.space; empty = use CALENDAR_2_KEY
INTRANET_API_KEY=""
# Shared with thfradio.space (WEBSITE_REVALIDATE_TOKEN there)
REVALIDATE_TOKEN="SECRET"

# Old Mixcloud shows (2019–2025): played from thfradio.space's own copy (same key).
# "mixcloud" = back to Mixcloud's API and widget, no new code needed: restart, then
# open /api/revalidate/cloudshows?token=<REVALIDATE_TOKEN> (else it takes up to 6 h).
#ARCHIVE_SOURCE="mixcloud"

# Staff + Community Picks (homepage). Key defaults to CALENDAR_2_KEY.
COMMUNITY_PICKS_URL="https://www.thfradio.space/api/public/community-picks"
#COMMUNITY_PICKS_KEY="your-api-key"

# Shows from thfradio.space (see INTRANET_SHOWS.md)
# "intranet" = read show info from thfradio.space, old backend only as fallback.
SHOWS_SOURCE="backend"
INTRANET_API_URL="https://www.thfradio.space"
# Timetable API key from thfradio.space; empty = use CALENDAR_2_KEY
INTRANET_API_KEY=""
# Shared with thfradio.space (WEBSITE_REVALIDATE_TOKEN there)
REVALIDATE_TOKEN="SECRET"

 

# Strapi

STRAPI_PUBLIC_API_URL="https://cms.thfradio.com/api/"

CMS_URL="https://cms.thfradio.com"
NEXT_PUBLIC_CMS_URL="http://localhost:1337"

STRAPI_WEBHOOK_SECRET="SECRET"

 

